# Standalone development harness (`gjs -m app.js`). It runs the prefs UI
# outside GNOME Shell and is never imported by extension.js or prefs.js.
# It self-executes at import, so keep it out of the submission.
app.js

ext.sh
build.py
install.py
check.sh
check-symbols.js

Makefile
Todo.md
Changelog.md

# .gitignore carries `*.compiled` to keep the binary out of version control,
# and build.py/install.py read both ignore files. Without this negation the
# schema is dropped from every package and app/config.js cannot resolve its
# GSettings schema, so preferences fail to open on a clean install.
!schemas/gschemas.compiled

# Same trap, same fix. `*.mo` joined .gitignore when the catalogs stopped being
# committed, which silently dropped every compiled translation from the package
# — the extension still ran, just always in English.
!locale/**/*.mo
