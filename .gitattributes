# Files kept out of `git archive` output, which is what GitHub serves for
# "Download ZIP" and for the auto-generated source archives on a Release.
#
# `/po export-ignore` was REMOVED deliberately. install.py compiles catalogs
# from po/*.po at install time; with po/ excluded it never could, and now that
# .mo files are untracked there is nothing left to fall back on. Excluding po/
# would mean no translations for anyone installing from source.

/ui export-ignore
/.vscode export-ignore
/.github export-ignore
.gitignore export-ignore
.extensionignore export-ignore
.gitattributes export-ignore

# Docs
Todo.md export-ignore
Changelog.md export-ignore
Readme.md export-ignore

# Blog
Makefile export-ignore

# scripts
check.sh export-ignore

# JS
app.js export-ignore
check-symbols.js export-ignore

# Python
build.py export-ignore
install.py export-ignore
